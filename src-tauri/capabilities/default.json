
{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://microsoft.com/*" },
        { "url": "https://www.microsoft.com/*" },
        { "url": "https://login.microsoftonline.com/*" }
      ]
    }
  ]
}
